<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0"><diagram name="1 Overview" id="1-overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Mangadeck: a replacement web UI for Suwayomi-Server. Colours: blue = UI, green = logic (src/lib), yellow = API layer, purple = browser storage, orange = server, red = outside services, grey = your disk." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontStyle=2;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Mangadeck in the browser (React 18 + TypeScript + Vite, TanStack Query, react-router)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=#f9f9f9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="780" height="800" as="geometry"/></mxCell><mxCell id="c4" value="Pages (src/pages)&lt;br&gt;Library · Manga · Reader · Updates · Downloads · Browse (Sources + Extensions) · Source · Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="740" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Components (src/components)&lt;br&gt;Layout (starts pacer, exporter, download watch) · Cover · ui.tsx · LoginDialog · SourceResults · PacedJobs · ExportJobs · HistoryList · LinkedSources · LocalFiles · MergeDialog · ShareDialog · VolumeDialog · RecDialog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="740" height="90" as="geometry"/></mxCell><mxCell id="c6" value="API layer (src/api)&lt;br&gt;client.ts: gql() fetch client, UI_LOGIN JWT + refresh, 502/503/504 retry, fetchBlob()&lt;br&gt;queries.ts: ALL hand-written queries/mutations (Q.*, M.*) and types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="740" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Logic (src/lib)&lt;br&gt;groups (scanlation groups) · volumes / volumeStore / volumeRules / remoteRules / wikiImport / volumeShare&lt;br&gt;pacer / exportJobs / export / zip / zipRead / merge · sourceLinks / migrate · history / downloadWatch · folderStore&lt;br&gt;settings · useImage · format · search · recommend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="740" height="110" as="geometry"/></mxCell><mxCell id="c8" value="localStorage&lt;br&gt;mangadeck.settings · server · history · exportjobs · merged · remoteRules · rulesApplied · access/refresh tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="360" height="90" as="geometry"/></mxCell><mxCell id="c9" value="IndexedDB (mangadeck-folders)&lt;br&gt;folder handle per manga (where its .cbz files are)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="520" width="360" height="90" as="geometry"/></mxCell><mxCell id="c10" value="File System Access API&lt;br&gt;save picker, folder picker, read/write .cbz&lt;br&gt;(Chrome / Edge; others download or use a file input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="740" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Your disk: .cbz volumes, series files, merged files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="740" height="60" as="geometry"/></mxCell><mxCell id="c12" value="nginx :8080&lt;br&gt;serves the built app&lt;br&gt;proxies /api to Suwayomi (no CORS, 300 s read timeout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="260" height="90" as="geometry"/></mxCell><mxCell id="c13" value="Suwayomi-Server :4567&lt;br&gt;GraphQL API (v2.4.2366)&lt;br&gt;library · chapters · download queue · manga meta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="910" width="260" height="100" as="geometry"/></mxCell><mxCell id="c14" value="Manga sources&lt;br&gt;(extensions, e.g. Keiyoushi repo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="1060" width="260" height="70" as="geometry"/></mxCell><mxCell id="c15" value="suwayomi-data/&lt;br&gt;downloads (.cbz per chapter), DB, volume lists as manga meta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="1060" width="300" height="90" as="geometry"/></mxCell><mxCell id="c16" value="Wikipedia / Fandom wikis&lt;br&gt;volume lists, chapter ranges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="320" height="70" as="geometry"/></mxCell><mxCell id="c17" value="AniList&lt;br&gt;recommendations, hover descriptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="320" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Supabase (free tier)&lt;br&gt;table volume_submissions (RLS: insert unapproved, read approved)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="320" height="90" as="geometry"/></mxCell><mxCell id="c19" value="Git repo (GitHub)&lt;br&gt;src/data/volumeRules.json shared with every user&lt;br&gt;scripts: volumes:export / volumes:import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="640" width="320" height="100" as="geometry"/></mxCell><mxCell id="c20" value="GraphQL /api + images" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="proxy_pass" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="fetch chapters, pages" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="read/write" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="volume lookup, wiki import" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="recommendations" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="share, approved rules" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="volumes:import (approved rows)" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="volumes:export" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="persist" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="folders" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="write / read" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Volumes and rules" id="2-volumes-and-rules"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Suwayomi has no volume data, so Mangadeck works volumes out itself. Hand-made lists can be shared, and end up in volumeRules.json in git." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontStyle=2;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. Finding and saving a volume list" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=#f9f9f9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1560" height="540" as="geometry"/></mxCell><mxCell id="c4" value="Find volumes&lt;br&gt;lookupVolumes(title)&lt;br&gt;(also takeRule() the first time a series is opened)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="Rules first (source: rule)&lt;br&gt;1. approved community rows (remoteRules)&lt;br&gt;2. built-in volumeRules.json&lt;br&gt;title variants tried" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="280" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Wikipedia &quot;List of X chapters/volumes&quot;&lt;br&gt;parseVolumeRanges(): several runs, picks one&lt;br&gt;(chapters keep counting up, heading matches, longest)&lt;br&gt;titleVariants() for subtitles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="320" height="110" as="geometry"/></mxCell><mxCell id="c7" value="No automatic source: Set / Edit volumes&lt;br&gt;type &quot;1: 0-12&quot;, paste a list, or import a wiki link&lt;br&gt;(wikiImport: Wikipedia list, one Fandom volume page,&lt;br&gt;or a one-page &quot;Chapters&quot; list)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="320" height="110" as="geometry"/></mxCell><mxCell id="c8" value="parseVolumeText()&lt;br&gt;reads &quot;Volume N ... Chapter A-B&quot; text;&lt;br&gt;stops at omake / special headings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1350" y="80" width="210" height="110" as="geometry"/></mxCell><mxCell id="c9" value="saveVolumes() (volumeStore)&lt;br&gt;newest copy (savedAt) wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Used by the manga page:&lt;br&gt;volume grouping, &quot;Download .cbz&quot; per volume,&lt;br&gt;each-volume export, missing-volume checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="340" height="90" as="geometry"/></mxCell><mxCell id="c11" value="This browser&lt;br&gt;settings.volumes[mangaId]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="240" height="90" as="geometry"/></mxCell><mxCell id="c12" value="Suwayomi server&lt;br&gt;manga meta &quot;mangadeck.volumes&quot;&lt;br&gt;(under 4,000 chars: slim copy drops titles, dates, ISBNs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="300" height="90" as="geometry"/></mxCell><mxCell id="c13" value="B. Sharing hand-made lists with every user" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=#f9f9f9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1560" height="250" as="geometry"/></mxCell><mxCell id="c14" value="Share link on the manga page&lt;br&gt;ShareDialog: title + chapter ranges only,&lt;br&gt;nothing personal (hand-made lists, source: manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="300" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Supabase volume_submissions&lt;br&gt;Send inserts approved = false&lt;br&gt;(RLS: anon insert unapproved, read approved)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="390" y="670" width="280" height="90" as="geometry"/></mxCell><mxCell id="c16" value="Maintainer ticks &quot;approved&quot;&lt;br&gt;in the Supabase dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="670" width="240" height="90" as="geometry"/></mxCell><mxCell id="c17" value="npm run volumes:import&lt;br&gt;copies approved rows into the JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="670" width="240" height="90" as="geometry"/></mxCell><mxCell id="c18" value="src/data/volumeRules.json&lt;br&gt;(in git, shipped to every user,&lt;br&gt;checked by Find volumes before Wikipedia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1300" y="700" width="260" height="100" as="geometry"/></mxCell><mxCell id="c19" value="npm run volumes:export (before every commit)&lt;br&gt;reads every manga's saved list from Suwayomi,&lt;br&gt;copies the hand-made ones into the JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="780" width="400" height="60" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="no rule" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="none" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="text" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="found" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="found" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="source: manual" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="setMangaMeta" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Send" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Downloads, exports, merge" id="3-downloads-exports-merge"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Everything that downloads is paced (one chapter at a time, wait + backoff from Settings). Suwayomi has no delay setting of its own." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontStyle=2;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Manga page actions&lt;br&gt;Download N missing · All as .cbz · Each volume as .cbz · per-volume .cbz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="100" as="geometry"/></mxCell><mxCell id="c4" value="Linked sources (sourceLinks.ts, LinkedSources)&lt;br&gt;same series on another source, matched by chapter number:&lt;br&gt;fills gaps, fallback after 3 failures (tryLinkedSources),&lt;br&gt;Move here (migrate.ts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="280" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Paced jobs (pacer.ts)&lt;br&gt;startPacedJob → downloadOne(); auto-pause after 3 failures;&lt;br&gt;Web Lock: one tab runs it; shown by PacedJobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="380" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Export jobs (exportJobs.ts, shown by ExportJobs)&lt;br&gt;phase 1 downloading: a chapter failing 3 times is set aside,&lt;br&gt;retried once after 5 min&lt;br&gt;phase 2 packing; resumable; saved in localStorage;&lt;br&gt;Web Lock mangadeck-exporter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="380" height="150" as="geometry"/></mxCell><mxCell id="c7" value="downloadOne(chapterId)&lt;br&gt;enqueue → startDownloader → wait&lt;br&gt;M.enqueueChapterDownloads / Q.downloads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="280" height="90" as="geometry"/></mxCell><mxCell id="c8" value="Downloads page&lt;br&gt;Retry / Retry N failed (dequeue + enqueue + start)&lt;br&gt;gql(): 502 / 503 / 504 retried after 1.5 s and 4 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="280" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Suwayomi download queue&lt;br&gt;QUEUED · DOWNLOADING · FINISHED · ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1160" y="150" width="280" height="90" as="geometry"/></mxCell><mxCell id="c10" value="History (history.ts, HistoryList)&lt;br&gt;finished + failed downloads; .cbz with &quot;Saved: file&quot;;&lt;br&gt;downloadWatch logs downloads started elsewhere" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="280" height="110" as="geometry"/></mxCell><mxCell id="c11" value="buildCbz(): fetch pages, name v01_c0003_p004.jpg,&lt;br&gt;ComicInfo.xml; ZipBuilder (stored, ZIP64 past 4 GB)&lt;br&gt;streams to a sink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="380" height="110" as="geometry"/></mxCell><mxCell id="c12" value="File on your disk&lt;br&gt;(save picker / picked folder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="465" width="280" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Merge .cbz files" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=#f9f9f9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1560" height="280" as="geometry"/></mxCell><mxCell id="c14" value="Remembered folder per manga&lt;br&gt;folderStore.ts (IndexedDB handle); set by&lt;br&gt;&quot;Each volume as .cbz&quot; or Choose folder;&lt;br&gt;one click to re-allow after a restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="300" height="110" as="geometry"/></mxCell><mxCell id="c15" value="LocalFiles panel (manga page)&lt;br&gt;lists matching .cbz (nameMatchesSeries, volumesInName),&lt;br&gt;shows have / missing volumes; tick files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="300" height="110" as="geometry"/></mxCell><mxCell id="c16" value="MergeDialog&lt;br&gt;order by volume, warnings (gaps, dupes, mixed series),&lt;br&gt;save into the same folder (never overwrites)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="660" width="300" height="110" as="geometry"/></mxCell><mxCell id="c17" value="merge.ts + zipRead.ts&lt;br&gt;readZip() central directory (ZIP64 ok)&lt;br&gt;mergeParts(): copy stored bytes with addRaw()&lt;br&gt;(no recompress), 001_00001_name.jpg, new ComicInfo.xml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="650" width="320" height="130" as="geometry"/></mxCell><mxCell id="c18" value="localStorage mangadeck.merged&lt;br&gt;sources marked &quot;merged into X&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="300" height="70" as="geometry"/></mxCell><mxCell id="c19" value="fills gaps" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="bulk download" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value=".cbz export" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" t